[Unit]
Description=Minecraft Telegram Authentication Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=minecraft-auth
Group=minecraft-auth
WorkingDirectory=/var/lib/minecraft-auth
EnvironmentFile=/etc/minecraft-auth.env
ExecStart=/opt/minecraft-auth/current/bin/auth-backend
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minecraft-auth

[Install]
WantedBy=multi-user.target
